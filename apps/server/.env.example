# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Used today ---

# Local Postgres via `docker compose up -d` at the repo root uses these credentials by default.
DATABASE_URL="postgresql://docsync:docsync@localhost:5432/docsync?schema=public"

# Optional — defaults to 4000 if unset (see src/index.ts).
PORT=4000

# --- Not wired up yet (see docs/techspec.md) — placeholders for upcoming phases ---

# Auth (Section 10 of techspec.md) — not implemented yet.
JWT_SECRET=

# Web Push (Section 6) — generate with `pnpm exec web-push generate-vapid-keys` once the
# `web-push` package is added; not implemented yet.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Speech-to-text (Section 5) — from your OpenAI dashboard; not implemented yet.
WHISPER_API_KEY=
