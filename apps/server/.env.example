DATABASE_URL="postgresql://docsync:docsync@localhost:5432/docsync?schema=public"
PORT=3000
SERVER_ORIGIN="http://localhost:3000"
WEB_ORIGIN="http://localhost:4000"
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web Push. All three or none: push stays off unless the set is complete.
# Generate a pair with:  pnpm exec web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL identifying you to the push service.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:dev@docsync.local"
# Self-hosted speech-to-text (apps/stt). Internal only.
STT_URL="http://127.0.0.1:8000"
